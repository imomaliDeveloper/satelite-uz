// SATELITE.UZ - Prisma Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  role        String    @default("STUDENT") // "STUDENT" | "ADMIN"
  avatar      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  isActive    Boolean   @default(true)

  // Relations
  createdQuestions Question[]        @relation("QuestionCreator")
  practiceSessions PracticeSession[]
  userAnswers      UserAnswer[]
  bookmarks        Bookmark[]

  @@index([email])
  @@index([role])
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  topics           Topic[]
  questions        Question[]
  practiceSessions PracticeSession[]

  @@index([slug])
  @@index([isActive])
}

model Topic {
  id          String   @id @default(cuid())
  subjectId   String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions        Question[]
  practiceSessions PracticeSession[]

  @@unique([subjectId, slug])
  @@index([subjectId])
}

model Question {
  id           String   @id @default(cuid())
  subjectId    String
  topicId      String
  questionText String
  questionType String   @default("MULTIPLE_CHOICE") // "MULTIPLE_CHOICE" | "MULTI_SELECT" | "TRUE_FALSE"
  difficulty   String   @default("MEDIUM")          // "EASY" | "MEDIUM" | "HARD"
  explanation            String?
  imageUrl               String?
  isPublished            Boolean        @default(true)
  calculatorAllowed      Boolean        @default(true)
  referenceSheetAllowed  Boolean        @default(true)
  createdById            String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic         Topic          @relation(fields: [topicId], references: [id], onDelete: Restrict)
  creator       User?          @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  options       AnswerOption[]
  examQuestions ExamQuestion[]
  userAnswers   UserAnswer[]
  bookmarks     Bookmark[]

  @@index([subjectId])
  @@index([topicId])
  @@index([difficulty])
  @@index([isPublished])
  @@index([createdAt])
}

model AnswerOption {
  id          String   @id @default(cuid())
  questionId  String
  optionText  String
  optionLabel String   // "A", "B", "C", "D"
  isCorrect   Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Exam {
  id              String   @id @default(cuid())
  title           String
  description     String?
  durationMinutes Int      @default(60)
  totalQuestions         Int            @default(0)
  isPublished            Boolean        @default(true)
  calculatorAllowed      Boolean        @default(true)
  referenceSheetAllowed  Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  examQuestions    ExamQuestion[]
  practiceSessions PracticeSession[]

  @@index([isPublished])
}

model ExamQuestion {
  id         String @id @default(cuid())
  examId     String
  questionId String
  order      Int    @default(0)

  // Relations
  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
}

model PracticeSession {
  id              String    @id @default(cuid())
  userId          String
  examId          String?
  subjectId       String?
  topicId         String?
  mode            String    @default("PRACTICE") // "PRACTICE" | "EXAM"
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  score           Float     @default(0)
  totalQuestions  Int       @default(0)
  correctAnswers  Int       @default(0)
  wrongAnswers    Int       @default(0)
  skippedAnswers  Int       @default(0)
  durationSeconds Int       @default(0)

  // Relations
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  exam    Exam?        @relation(fields: [examId], references: [id], onDelete: SetNull)
  answers UserAnswer[]

  @@index([userId])
  @@index([mode])
  @@index([startedAt])
}

model UserAnswer {
  id               String   @id @default(cuid())
  userId           String
  sessionId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean  @default(false)
  createdAt        DateTime @default(now())

  // Relations
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session  PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([questionId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
}
