{
  "name": "satelite-uz-backend",
  "version": "1.0.0",
  "description": "SATELITE.UZ - Digital Exam Preparation & Question-Bank Platform API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:prepare": "node prisma/prepare-db.js",
    "prisma:generate": "npm run prisma:prepare && prisma generate",
    "prisma:migrate": "npm run prisma:prepare && prisma migrate dev",
    "prisma:push": "npm run prisma:prepare && prisma db push",
    "prisma:seed": "node src/utils/seed.js",
    "seed": "node src/utils/seed.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
