# SATELITE.UZ Environment Variables

# PostgreSQL Connection String (Production / Local PostgreSQL)
# Example: postgresql://username:password@localhost:5432/satelite_db?schema=public
# For zero-config local testing without Postgres running: file:./dev.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/satelite_db?schema=public"

# JWT Secret & Expiration
JWT_SECRET="satelite_uz_super_secret_jwt_key_2026_exam_platform_secure_token"
JWT_EXPIRES_IN="7d"

# Server Port & Environment
PORT=5000
NODE_ENV="development"

# Client URL (for CORS and frontend asset paths)
CLIENT_URL="http://localhost:5000"

# Uploads directory
UPLOAD_DIR="./uploads"
