{
  "version": 2,
  "outputDirectory": "frontend",
  "buildCommand": "node backend/prisma/prepare-db.js && prisma generate --schema=backend/prisma/schema.prisma",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api-docs/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api-docs",
      "destination": "/api/index.js"
    }
  ]
}
