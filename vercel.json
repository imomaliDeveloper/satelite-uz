{
  "version": 2,
  "buildCommand": "node backend/prisma/prepare-db.js && prisma generate --schema=backend/prisma/schema.prisma && node backend/prisma/migrate-neon.js",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api-docs/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api-docs",
      "destination": "/api/index.js"
    }
  ]
}
